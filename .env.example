# AgentEnvPool V0.1 configuration
# Copy this file to .env and adjust values as needed.

# SQLite metadata database.
AGENT_ENV_POOL_DATABASE_URL=sqlite+aiosqlite:///./agent_env_pool.db

# Browser sandbox image and the container-side CDP port.
# browser-use-chrome exposes its external CDP proxy on 9223.
AGENT_ENV_POOL_DOCKER_BROWSER_IMAGE=browser-use-chrome:latest
AGENT_ENV_POOL_DOCKER_BROWSER_PORT=9223

# Host/IP that rollout workers use to reach Docker-assigned CDP ports.
AGENT_ENV_POOL_PUBLIC_HOST=127.0.0.1

# Optional host used by the API service itself for Docker endpoint readiness checks.
# Useful when running the API inside Docker while sandbox ports are published on the host.
# Example for docker-compose on Linux:
# AGENT_ENV_POOL_DOCKER_READY_HOST=host.docker.internal

# Docker container name prefix.
AGENT_ENV_POOL_CONTAINER_NAME_PREFIX=agent-env-pool

# Maximum number of active sandboxes.
AGENT_ENV_POOL_MAX_POOL_SIZE=32

# CDP readiness check.
AGENT_ENV_POOL_READY_CHECK_TIMEOUT_SECONDS=60
AGENT_ENV_POOL_READY_CHECK_INTERVAL_SECONDS=1.0

# Logging.
AGENT_ENV_POOL_LOG_LEVEL=INFO
